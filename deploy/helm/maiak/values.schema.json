{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "required": ["cpu", "memory"]},
        "limits": {"type": "object", "required": ["memory"]}
      }
    },
    "grace": {"type": "integer", "minimum": 1, "maximum": 600}
  },
  "required": ["image", "config", "secrets", "api", "worker", "jobs", "web", "migration", "httpRoute", "dbBootstrap"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}}
    },
    "config": {
      "type": "object",
      "required": ["env", "logLevel", "adminPort", "publicUrl"],
      "properties": {
        "env": {"type": "string", "minLength": 1},
        "logLevel": {"type": "string", "enum": ["debug", "info", "warn", "error"]},
        "adminPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "sessionTTL": {"type": "string"},
        "cookieSecure": {"type": "boolean"},
        "trustedProxyHops": {"type": "integer", "minimum": 0, "maximum": 10},
        "publicUrl": {
          "type": "string",
          "description": "MAIAK_PUBLIC_URL: https, no trailing slash, no user info, query or link-breaking characters",
          "pattern": "^https://[^\\s/|<>&\"'?#@]+(/[^\\s|<>&\"'?#]*[^\\s/|<>&\"'?#])?$"
        },
        "blockedCIDRs": {
          "type": "array",
          "description": "MAIAK_BLOCKED_CIDRS: extra SSRF guard ranges",
          "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["admin", "crypto", "bootstrap"],
      "properties": {
        "admin": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": {"type": "string", "enum": ["generate", "externalSecret"]},
            "login": {
              "type": "string",
              "description": "system admin login (generate mode): 1-64 of [a-z0-9._@-]",
              "pattern": "^[a-z0-9._@-]{1,64}$"
            },
            "remoteKey": {"type": "string"}
          },
          "allOf": [
            {
              "if": {"properties": {"source": {"const": "generate"}}},
              "then": {"required": ["login"]}
            },
            {
              "if": {"properties": {"source": {"const": "externalSecret"}}},
              "then": {"required": ["remoteKey"], "properties": {"remoteKey": {"minLength": 1}}}
            }
          ]
        },
        "crypto": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": {"type": "string", "enum": ["generate", "externalSecret"]},
            "keyId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
            "remoteKey": {"type": "string"}
          },
          "allOf": [
            {
              "if": {"properties": {"source": {"const": "generate"}}},
              "then": {"required": ["keyId"]}
            },
            {
              "if": {"properties": {"source": {"const": "externalSecret"}}},
              "then": {"required": ["remoteKey"], "properties": {"remoteKey": {"minLength": 1}}}
            }
          ]
        },
        "bootstrap": {
          "type": "object",
          "required": ["command", "resources"],
          "properties": {
            "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 6},
            "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
            "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
            "resources": {"$ref": "#/definitions/resources"}
          }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "creationPolicy": {"type": "string", "enum": ["Owner", "Orphan", "Merge", "None"]},
        "refreshInterval": {"type": "string"},
        "secretStoreRef": {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": {"type": "string", "enum": ["ClusterSecretStore", "SecretStore"]},
            "name": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "api": {
      "type": "object",
      "required": ["replicas", "command", "databaseUrlKey", "httpPort", "resources"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 0},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "databaseUrlKey": {"type": "string", "enum": ["api_url", "worker_url", "owner_url"]},
        "httpPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "terminationGracePeriodSeconds": {"$ref": "#/definitions/grace"},
        "resources": {"$ref": "#/definitions/resources"},
        "pdb": {"type": "object", "properties": {"enabled": {"type": "boolean"}}}
      }
    },
    "worker": {
      "type": "object",
      "required": ["replicas", "command", "databaseUrlKey", "resources"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 0},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "databaseUrlKey": {"type": "string", "enum": ["api_url", "worker_url", "owner_url"]},
        "terminationGracePeriodSeconds": {"$ref": "#/definitions/grace"},
        "claimBatch": {"type": "integer", "minimum": 1, "maximum": 1000},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 1000},
        "tenantConcurrency": {"type": "integer", "minimum": 1, "maximum": 1000},
        "hostConcurrency": {"type": "integer", "minimum": 1, "maximum": 1000},
        "location": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", "maxLength": 63, "description": "MAIAK_WORKER_LOCATION: DNS label"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "jobs": {
      "type": "object",
      "required": ["replicas", "command", "databaseUrlKey", "resources"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 0, "maximum": 1, "description": "jobs must stay a singleton"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "databaseUrlKey": {"type": "string", "enum": ["api_url", "worker_url", "owner_url"]},
        "terminationGracePeriodSeconds": {"$ref": "#/definitions/grace"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "web": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "resources": {"$ref": "#/definitions/resources"},
        "image": {
          "type": "object",
          "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string"}}
        }
      }
    },
    "dbBootstrap": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "dbName": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
        "sslmode": {"type": "string", "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]},
        "secretName": {"type": "string", "minLength": 1},
        "adminSecret": {
          "type": "object",
          "required": ["remoteKey", "properties"],
          "properties": {
            "remoteKey": {"type": "string", "minLength": 1},
            "properties": {
              "type": "object",
              "required": ["username", "password"],
              "properties": {
                "username": {"type": "string", "minLength": 1},
                "password": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 6},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
        "resources": {"$ref": "#/definitions/resources"}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"required": ["host"], "properties": {"host": {"minLength": 1}}}
    },
    "migration": {
      "type": "object",
      "required": ["hookPhase", "command", "databaseUrlKey"],
      "properties": {
        "hookPhase": {"type": "string", "enum": ["PreSync", "Sync"]},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "databaseUrlKey": {"type": "string", "enum": ["api_url", "worker_url", "owner_url"]},
        "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 6},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "httpRoute": {
      "type": "object",
      "required": ["enabled", "hostnames", "parentRef"],
      "properties": {
        "enabled": {"type": "boolean"},
        "hostnames": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "parentRef": {
          "type": "object",
          "required": ["name", "namespace", "sectionName"],
          "properties": {
            "name": {"type": "string"},
            "namespace": {"type": "string"},
            "sectionName": {"type": "string"}
          }
        },
        "apiPathPrefix": {"type": "string", "pattern": "^/"},
        "apiRequestTimeout": {"type": "string"}
      }
    },
    "networkPolicy": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "serviceMonitor": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "topologySpread": {"type": "object", "properties": {"enabled": {"type": "boolean"}}}
  }
}
